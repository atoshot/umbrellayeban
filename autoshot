local BgOverlayModule = (function()
    local CONFIG = {
        OverlayColor           = Color3.new(0, 0, 0),
        OverlayTransparencyOn  = 0.3,
        OverlayTransparencyOff = 1.0,
        TweenTime              = 0.4,
        ParticleCount     = 140,
        MinSize           = 1, MaxSize = 3,
        MinSpeed          = 15, MaxSpeed = 55,
        MinDrift          = -8, MaxDrift = 8,
        MinTransparency   = 0.35, MaxTransparency = 0.75,
        Color             = Color3.fromRGB(240, 180, 220),
        LineColor         = Color3.fromRGB(230, 142, 200),
        ConnectRadius     = 120,
        LineThickness     = 1,
    }
    local function createLinePool(parent)
        local active = {}
        local function acquire()
            for _, line in ipairs(active) do
                if not line.Visible then line.Visible = true; return line end
            end
            local line = Instance.new("Frame")
            line.AnchorPoint = Vector2.new(0.5, 0.5)
            line.BackgroundColor3 = CONFIG.LineColor or CONFIG.Color
            line.BorderSizePixel = 0
            line.Size = UDim2.new(0, 0, 0, CONFIG.LineThickness)
            line.ZIndex = 1
            line.Visible = true
            line.Parent = parent
            table.insert(active, line)
            return line
        end
        local function releaseAll()
            for _, line in ipairs(active) do line.Visible = false end
        end
        local function destroy()
            for _, line in ipairs(active) do line:Destroy() end
            table.clear(active)
        end
        return acquire, releaseAll, destroy
    end

    local M = {}
    M.__index = M

    function M.new(parent)
        local self = setmetatable({}, M)
        self.parent = parent
        self.particles = {}
        self.enabled = false
        self.destroyed = false

        self.overlay = Instance.new("Frame")
        self.overlay.Name = "BgOverlay"
        self.overlay.Size = UDim2.new(1, 0, 1, 0)
        self.overlay.BackgroundColor3 = CONFIG.OverlayColor
        self.overlay.BackgroundTransparency = CONFIG.OverlayTransparencyOff
        self.overlay.BorderSizePixel = 0
        self.overlay.ZIndex = 0
        self.overlay.Parent = parent

        self.snowContainer = Instance.new("Frame")
        self.snowContainer.Name = "SandContainer"
        self.snowContainer.Size = UDim2.new(1, 0, 1, 0)
        self.snowContainer.BackgroundTransparency = 1
        self.snowContainer.ZIndex = 1
        self.snowContainer.Parent = self.overlay

        self.acquireLine, self.releaseAllLines, self.destroyLinePool = createLinePool(self.snowContainer)
        self:_spawnParticles()
        self.conn = RS.RenderStepped:Connect(function(delta) self:_update(delta) end)
        return self
    end

    function M:_cameraViewport()
        local cam = WS.CurrentCamera
        if cam then return cam.ViewportSize end
        return Vector2.new(1920, 1080)
    end

    function M:_spawnParticles()
        local vp = self:_cameraViewport()
        local sandPalette = {
            Color3.fromRGB(240, 180, 220),
            Color3.fromRGB(230, 142, 200),
            Color3.fromRGB(255, 200, 230),
            Color3.fromRGB(200, 130, 180),
        }
        for i = 1, CONFIG.ParticleCount do
            local size = math.random(CONFIG.MinSize, CONFIG.MaxSize)
            local frame = Instance.new("Frame")
            frame.Name = "SandGrain_" .. i
            frame.BackgroundColor3 = sandPalette[math.random(1, #sandPalette)]
            frame.BackgroundTransparency = math.random(
                math.floor(CONFIG.MinTransparency * 100),
                math.floor(CONFIG.MaxTransparency * 100)
            ) / 100
            frame.Size = UDim2.new(0, size, 0, size)
            frame.BorderSizePixel = 0
            frame.ZIndex = 1
            frame.Visible = false
            frame.Parent = self.snowContainer
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 1)
            corner.Parent = frame
            table.insert(self.particles, {
                Obj = frame,
                X = math.random() * vp.X,
                Y = math.random() * vp.Y,
                Speed = math.random(CONFIG.MinSpeed, CONFIG.MaxSpeed),
                Drift = math.random(CONFIG.MinDrift, CONFIG.MaxDrift),
            })
        end
    end

    function M:_update(delta)
        if self.destroyed then return end
        self.releaseAllLines()
        if not self.enabled then
            for _, p in ipairs(self.particles) do p.Obj.Visible = false end
            return
        end
        local cam = WS.CurrentCamera
        if not cam then return end
        local mouse = UIS:GetMouseLocation()
        local vp = cam.ViewportSize
        for _, p in ipairs(self.particles) do
            p.Obj.Visible = true
            p.Y = p.Y + p.Speed * delta
            p.X = p.X + p.Drift * delta
            if p.Y > vp.Y then p.Y = -10; p.X = math.random() * vp.X end
            if p.X < -10 then p.X = vp.X + 10
            elseif p.X > vp.X + 10 then p.X = -10 end
            p.Obj.Position = UDim2.new(0, p.X, 0, p.Y)
            local dx = p.X - mouse.X
            local dy = p.Y - mouse.Y
            local dist = math.sqrt(dx * dx + dy * dy)
            if dist < CONFIG.ConnectRadius then
                local line = self.acquireLine()
                line.BackgroundColor3 = CONFIG.LineColor or CONFIG.Color
                line.Size = UDim2.new(0, dist, 0, CONFIG.LineThickness)
                line.Position = UDim2.new(0, (p.X + mouse.X) / 2, 0, (p.Y + mouse.Y) / 2)
                line.Rotation = math.deg(math.atan2(dy, dx))
                line.BackgroundTransparency = dist / CONFIG.ConnectRadius
            end
        end
    end

    function M:setEnabled(state)
        state = not not state
        if state == self.enabled then return end
        self.enabled = state
        if state then
            TS:Create(self.overlay, TweenInfo.new(CONFIG.TweenTime),
                { BackgroundTransparency = CONFIG.OverlayTransparencyOn }):Play()
        else
            TS:Create(self.overlay, TweenInfo.new(CONFIG.TweenTime),
                { BackgroundTransparency = CONFIG.OverlayTransparencyOff }):Play()
        end
    end
    function M:show() self:setEnabled(true) end
    function M:hide() self:setEnabled(false) end
    function M:toggle() self:setEnabled(not self.enabled) end

    function M:setConfig(tbl)
        if type(tbl) ~= "table" then return end
        for k, v in pairs(tbl) do
            if CONFIG[k] ~= nil then CONFIG[k] = v end
        end
    end

    function M:destroy()
        if self.destroyed then return end
        self.destroyed = true
        if self.conn then self.conn:Disconnect(); self.conn = nil end
        if self.destroyLinePool then self.destroyLinePool() end
        if self.overlay then self.overlay:Destroy(); self.overlay = nil end
        self.particles = {}
    end

    return M
end)()

