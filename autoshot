        Morph(MorphSettings.SelectedUserId, LP.Name)
    elseif MorphSettings.SelectedUserName and MorphSettings.SelectedUserName ~= "None" then
        for _, user in pairs(MorphUsers) do
            if user.UserName == MorphSettings.SelectedUserName then
                Morph(user.UserId, LP.Name); break
            end
        end
    else
        if MorphSettings.HasHeadless then MorphApplyHeadless(char) end
        if MorphSettings.HasKorblox then MorphApplyKorblox(char) end
    end
end)
local function resolveUserId(input)
    input = tostring(input or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if input == "" then return nil, "empty input" end
    local asNum = tonumber(input)
    if asNum and asNum >= 1 and math.floor(asNum) == asNum then
        return math.floor(asNum), nil
    end
    local username = input:gsub("^@", "")
    if #username < 3 then return nil, "username too short" end
    local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(username) end)
    if ok and id and id > 0 then return id, nil end
    return nil, "player not found: " .. username
end

