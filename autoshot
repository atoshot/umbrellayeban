        mk("UICorner", { CornerRadius = UDim.new(0, 8) }, groupBox)
        mk("UIStroke", { Color = library.col_stroke, Thickness = 1 }, groupBox)
        local header = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26) }, groupBox)
        local hl = mk("Frame", {
            BackgroundColor3 = library.accent, BorderSizePixel = 0,
            Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(3, 12),
        }, header)
        mk("UICorner", { CornerRadius = UDim.new(0, 2) }, hl)
        mk("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(22, 0),
            Size = UDim2.new(1, -22, 1, 0), Font = Enum.Font.GothamBold,
            Text = groupName or "", TextColor3 = library.col_text,
            TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        }, header)
        local holder = mk("Frame", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 26),
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        }, groupBox)
        mk("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
        mk("UIPadding", {
            PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
        }, holder)
        local group = {}

        function group:addToggle(args)
            if not args.flag and args.text then args.flag = args.text end
            if not args.flag then return warn("missing flag") end
            local row = mk("TextButton", {
                BackgroundColor3 = library.col_elem, BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 28), Text = "", AutoButtonColor = false,
            }, holder)
            mk("UICorner", { CornerRadius = UDim.new(0, 6) }, row)
            local box = mk("Frame", {
                BackgroundColor3 = Color3.fromRGB(25, 25, 32), BorderSizePixel = 0,
                Position = UDim2.fromOffset(8, 7), Size = UDim2.fromOffset(14, 14),
            }, row)
            mk("UICorner", { CornerRadius = UDim.new(0, 3) }, box)
            local bs = mk("UIStroke", { Color = library.col_stroke, Thickness = 1 }, box)
            local fill = mk("Frame", {
                BackgroundColor3 = library.accent, BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(0, 0),
            }, box)
            mk("UICorner", { CornerRadius = UDim.new(0, 2) }, fill)
            local lbl = mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(30, 0),
                Size = UDim2.new(1, -38, 1, 0), Font = Enum.Font.Gotham,
                Text = args.text or args.flag, TextColor3 = library.col_sub,
                TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
            }, row)
            local state = false
            local function setState(s, fire)
                state = s and true or false
                library.flags[args.flag] = state
                if state then
                    TS:Create(fill, TweenInfo.new(0.15), { Size = UDim2.fromOffset(8, 8) }):Play()
                    TS:Create(bs, TweenInfo.new(0.15), { Color = library.accent }):Play()
                    TS:Create(lbl, TweenInfo.new(0.15), { TextColor3 = library.col_text }):Play()
                else
                    TS:Create(fill, TweenInfo.new(0.15), { Size = UDim2.fromOffset(0, 0) }):Play()
                    TS:Create(bs, TweenInfo.new(0.15), { Color = library.col_stroke }):Play()
                    TS:Create(lbl, TweenInfo.new(0.15), { TextColor3 = library.col_sub }):Play()
                end
                if fire ~= false and args.callback then task.spawn(args.callback, state) end
            end
            row.MouseButton1Click:Connect(function() setState(not state) end)
            library.flags[args.flag] = false
            library.options[args.flag] = { type = "toggle", changeState = setState }
            setState(false, false)
            return { set = setState, get = function() return state end }
        end

        function group:addButton(args)
            if not args.text or not args.callback then return warn("missing args") end
            local btn = mk("TextButton", {
                BackgroundColor3 = library.col_elem, BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 28), Font = Enum.Font.Gotham,
                Text = args.text, TextColor3 = library.col_text,
                TextSize = 13, AutoButtonColor = false,
            }, holder)
            mk("UICorner", { CornerRadius = UDim.new(0, 6) }, btn)
            btn.MouseButton1Click:Connect(function() task.spawn(args.callback) end)
        end

        function group:addKeybind(args)
            if not args.flag then return warn("keybind: missing flag") end
            local currentKey = args.default or nil
            local isListening = false

            local row = mk("TextButton", {
                BackgroundColor3 = library.col_elem, BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 28), Text = "", AutoButtonColor = false,
            }, holder)
            mk("UICorner", { CornerRadius = UDim.new(0, 6) }, row)
            local lbl = mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0),
                Size = UDim2.new(1, -100, 1, 0), Font = Enum.Font.Gotham,
                Text = args.text or args.flag, TextColor3 = library.col_text,
                TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
            }, row)
            local keyBtn = mk("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
                Size = UDim2.fromOffset(80, 20), BackgroundColor3 = Color3.fromRGB(25, 25, 32),
                BorderSizePixel = 0, Font = Enum.Font.GothamBold,
                Text = currentKey and currentKey.Name or "None",
                TextColor3 = currentKey and library.accent or library.col_sub,
                TextSize = 12, AutoButtonColor = false,
            }, row)
            mk("UICorner", { CornerRadius = UDim.new(0, 4) }, keyBtn)
            local keyStroke = mk("UIStroke", { Color = library.col_stroke, Thickness = 1 }, keyBtn)

            library.keybinds[args.flag] = {
                Key = currentKey, Callback = args.callback, Text = args.text or args.flag,
            }

            local function updateVisual()
                if currentKey then
                    keyBtn.Text = currentKey.Name
                    keyBtn.TextColor3 = library.accent
                    TS:Create(keyStroke, TweenInfo.new(0.15), { Color = library.accent }):Play()
                else
                    keyBtn.Text = "None"
                    keyBtn.TextColor3 = library.col_sub
                    TS:Create(keyStroke, TweenInfo.new(0.15), { Color = library.col_stroke }):Play()
                end
            end

            keyBtn.MouseButton1Click:Connect(function()
                if isListening then return end
                isListening = true
                keyBtn.Text = "[...]"
                keyBtn.TextColor3 = library.col_text
                library:notify("Press key for " .. (args.text or args.flag) .. " (Esc cancel)")
            end)

            UIS.InputBegan:Connect(function(input, gp)
                if gp then return end
                if not isListening then return end
                if input.UserInputType == Enum.UserInputType.Keyboard
                or input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.MouseButton2
                or input.UserInputType == Enum.UserInputType.MouseButton3 then
                    if input.KeyCode == Enum.KeyCode.Escape then
                        isListening = false; updateVisual(); return
                    end
                    currentKey = input.KeyCode
                    library.keybinds[args.flag].Key = currentKey
                    isListening = false
                    updateVisual()
                    library:notify("Bind " .. (args.text or args.flag) .. " = " .. currentKey.Name)
                end
            end)

            UIS.InputBegan:Connect(function(input, gp)
                if gp then return end
                local kb = library.keybinds[args.flag]
                if not kb or not kb.Key then return end
                if input.KeyCode ~= kb.Key then return end
                if args.callback then task.spawn(args.callback, kb.Key, true) end
            end)
            UIS.InputEnded:Connect(function(input, gp)
                if gp then return end
                local kb = library.keybinds[args.flag]
                if not kb or not kb.Key then return end
                if input.KeyCode ~= kb.Key then return end
                if args.callback then task.spawn(args.callback, kb.Key, false) end
            end)

            updateVisual()
            local api = {
                set = function(kc) currentKey = kc; library.keybinds[args.flag].Key = kc; updateVisual() end,
                get = function() return currentKey end,
                clear = function() currentKey = nil; library.keybinds[args.flag].Key = nil; updateVisual() end,
            }
            library.options[args.flag] = api
            return api
        end
        function group:addSlider(args, sub)
            if not args.flag or not args.max then return warn("missing args") end
            sub = sub or ""
            local minV = args.min or 0
            local value = args.value or minV
            local fractional = (args.max - minV) <= 1
            local row = mk("Frame", {
                BackgroundColor3 = library.col_elem, BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 42),
            }, holder)
            mk("UICorner", { CornerRadius = UDim.new(0, 6) }, row)
            local lbl = mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 4),
                Size = UDim2.new(1, -60, 0, 16), Font = Enum.Font.Gotham,
                Text = args.text or args.flag, TextColor3 = library.col_text,
                TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
            }, row)
            local valLbl = mk("TextLabel", {
                BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -10, 0, 4), Size = UDim2.fromOffset(50, 16),
                Font = Enum.Font.GothamBold, Text = tostring(value) .. sub,
                TextColor3 = library.accent, TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
            }, row)
            local track = mk("Frame", {
                BackgroundColor3 = Color3.fromRGB(25, 25, 32), BorderSizePixel = 0,
                Position = UDim2.fromOffset(10, 28), Size = UDim2.new(1, -20, 0, 6),
            }, row)
            mk("UICorner", { CornerRadius = UDim.new(0, 3) }, track)
            local fill = mk("Frame", { BackgroundColor3 = library.accent, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0) }, track)
            mk("UICorner", { CornerRadius = UDim.new(0, 3) }, fill)
            local knob = mk("Frame", {
                BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
                Size = UDim2.fromOffset(12, 12), ZIndex = 2,
            }, track)
            mk("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
            local btn = mk("TextButton", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Text = "" }, row)
            local function quantize(v)
                if fractional then return math.floor(v * 100) / 100 end
                return math.floor(v + 0.5)
            end
            local function update(v, fire)
                if v < minV then v = minV end
                if v > args.max then v = args.max end
                value = quantize(v)
                local pct = (value - minV) / (args.max - minV)
                fill.Size = UDim2.new(pct, 0, 1, 0)
                knob.Position = UDim2.new(pct, 0, 0.5, 0)
                valLbl.Text = tostring(value) .. sub
                library.flags[args.flag] = value
                if fire ~= false and args.callback then task.spawn(args.callback, value) end
            end
            local dragging = false
            local function tryDrag(input)
                if not dragging then return end
                local rel = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
                update(minV + rel * (args.max - minV))
            end
            btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true; tryDrag(input)
                end
            end)
            UIS.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then tryDrag(input) end
            end)
            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)
            library.options[args.flag] = { type = "slider", changeState = function(v) update(v, true) end }
            update(value, false)
        end

        function group:addDivider()
            local div = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 8) }, holder)
            mk("Frame", {
                BackgroundColor3 = library.col_stroke, BorderSizePixel = 0,
                Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.new(1, -8, 0, 1),
