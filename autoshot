function library:notify(text)
    local lbl = mk("TextLabel", {
        BackgroundColor3 = library.col_panel, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 30), Font = Enum.Font.Gotham,
        Text = "  " .. tostring(text), TextColor3 = library.col_text,
        TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        TextTransparency = 1, BackgroundTransparency = 1, ZIndex = 501,
    }, notifyHolder)
    mk("UICorner", { CornerRadius = UDim.new(0, 6) }, lbl)
    local stroke = mk("UIStroke", { Color = library.accent, Thickness = 1, Transparency = 1 }, lbl)
    if not notifyHolder:FindFirstChildOfClass("UIListLayout") then
        mk("UIListLayout", {
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder,
        }, notifyHolder)
    end
    task.spawn(function()
        TS:Create(lbl, TweenInfo.new(0.15), { BackgroundTransparency = 0.15, TextTransparency = 0 }):Play()
        TS:Create(stroke, TweenInfo.new(0.15), { Transparency = 0.4 }):Play()
        task.wait(2.5)
        TS:Create(lbl, TweenInfo.new(0.3), { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
        TS:Create(stroke, TweenInfo.new(0.3), { Transparency = 1 }):Play()
        task.wait(0.35); lbl:Destroy()
    end)
end

