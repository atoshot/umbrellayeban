local function findWatcherForMe()
    local myChar = LP.Character
    if not myChar then return nil end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local bestWatcher, bestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            local modChar = player.Character
            if modChar then
                local modHead = modChar:FindFirstChild("Head")
                if modHead then
                    local toMe = myHRP.Position - modHead.Position
                    local dist = toMe.Magnitude
                    if dist <= 300 then
                        if modHead.CFrame.LookVector:Dot(toMe.Unit) >= 0.85 then
                            local params = RaycastParams.new()
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            params.FilterDescendantsInstances = { modChar }
                            params.IgnoreWater = true
                            local result = WS:Raycast(modHead.Position, toMe, params)
                            if not result or not result.Instance
                            or result.Instance:FindFirstAncestorOfClass("Model") == myChar then
                                if dist < bestDist then bestDist = dist; bestWatcher = player end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestWatcher
end
local function spectateDetect()
    local remotes = ReplicatedStorage:FindFirstChild("AdminRemotes")
    if not remotes then return end
    local spec = remotes:FindFirstChild("AdminSpectateNew")
    if spec and spec:IsA("RemoteEvent") then
        spec.OnClientEvent:Connect(function(...)
            local args = { ... }
            local spectatorName, targetName
            for _, v in ipairs(args) do
                if type(v) == "string" then
                    if v == LP.Name then targetName = v else spectatorName = v end
                end
            end
            if targetName == LP.Name and spectatorName then
                currentSpectator = spectatorName; currentWatcherName = spectatorName
                currentSpectateTarget = LP.Name
                if _adminGroup then pcall(UpdateAdminList) end
            else
                if currentSpectator then
                    currentSpectator = nil; currentWatcherName = nil
                    if _adminGroup then pcall(UpdateAdminList) end
                end
                if spectatorName and targetName and targetName ~= LP.Name then
                    currentSpectateTarget = targetName
                    if _adminGroup then pcall(UpdateAdminList) end
                end
            end
        end)
    end
    task.spawn(function()
        local lastScan, cachedName = 0, nil
        while true do
            task.wait(0.05)
            local myChar = LP.Character
            if not myChar then
                if currentSpectator then
                    currentSpectator = nil; currentWatcherName = nil; cachedName = nil
                    if _adminGroup then pcall(UpdateAdminList) end
                end
            else
                local cam = GetCamera()
                local subject = cam and cam.CameraSubject
                local isMe = subject and (subject == myChar or subject:IsDescendantOf(myChar))
                local specActive = remotes:GetAttribute("SpecActive")
                if specActive and isMe then
                    local now = tick()
                    if now - lastScan > 0.5 then
                        lastScan = now
                        local w = findWatcherForMe()
                        cachedName = w and w.Name or nil
                    end
                    local nv = cachedName or "Admin spectating"
                    if currentSpectator ~= nv then
                        currentSpectator = nv; currentWatcherName = cachedName
                        currentSpectateTarget = LP.Name
                        if _adminGroup then pcall(UpdateAdminList) end
                        if cachedName then library:notify("Admin spectating: " .. cachedName) end
                    end
                else
                    cachedName = nil
                    if currentSpectator then
                        currentSpectator = nil; currentWatcherName = nil
                        if _adminGroup then pcall(UpdateAdminList) end
                    end
                end
            end
        end
    end)
end
