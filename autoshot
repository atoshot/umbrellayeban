                BackgroundColor3 = library.col_elem, BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 28), Text = "", AutoButtonColor = false,
            }, container)
            mk("UICorner", { CornerRadius = UDim.new(0, 6) }, headerBtn)
            local headerLbl = mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0),
                Size = UDim2.new(1, -40, 1, 0), Font = Enum.Font.Gotham,
                Text = args.text or args.flag, TextColor3 = library.col_text,
                TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
            }, headerBtn)
            local valueLbl = mk("TextLabel", {
                BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -28, 0.5, 0), Size = UDim2.new(0.5, -30, 1, 0),
