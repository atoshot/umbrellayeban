local function saValid(v)
    local s = getgenv().Silent
    if not v or not v.Character then return false end
    local hum = getHumanoid(v.Character)
    if not hum then return false end
    if hum.Health <= 0 then return false end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return false end
    if s.NoDead and hum.Health <= 0 then return false end
    if hum.Health < s.MinHealth then return false end
    if s.NoFriends and isFriend(v) then return false end
    if s.OnlyTarget then
        local role = GetRole(v)
        if role ~= "Target" then return false end
    end
    local part = getPart(v.Character, s.TargetPart)
    if not part then return false end
    if s.NoWall and hasWall(v.Character, part) then return false end
    return true
end

local function saGetClosest()
    local s = getgenv().Silent

    if s.BindMode == "Always" then
        if not s.Enabled then Silent.LockedTarget = nil; return nil end
    elseif s.BindMode == "Hold" then
        if not s.Enabled or not s.HoldActive then Silent.LockedTarget = nil; return nil end
    else
        if not s.Enabled or not s.HoldActive then Silent.LockedTarget = nil; return nil end
    end

    local prs = getgenv().PlayerRoleSystem

    if Silent.LockedTarget then
        if saValid(Silent.LockedTarget) and prs.canApply(Silent.LockedTarget, "SilentAim") then
            local role = prs.getRole(Silent.LockedTarget)
            if role == "Target" or (not s.OnlyTarget and role == "Neutral") then
                return Silent.LockedTarget
            end
        end
        Silent.LockedTarget = nil
    end

    local mx, my = Mouse.X, Mouse.Y
    local candidates = {}

    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= player and saValid(v) and prs.canApply(v, "SilentAim") then
            local part = getPart(v.Character, s.TargetPart)
            if part then
                local pos, onScreen = Camera:WorldToScreenPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(mx, my)).Magnitude
                    if dist < s.FOVRadius then
                        candidates[#candidates + 1] = {player = v, dist = dist}
                    end
                end
            end
        end
    end

    local best = prs.getBestTarget(candidates, "SilentAim")

    if best then
        Silent.LockedTarget = best
    end

    return best
end

