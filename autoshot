local triggerRayParams = RaycastParams.new()
triggerRayParams.FilterType = Enum.RaycastFilterType.Exclude
local function Get2DBoundingBox(part, camera)
    local size, cf = part.Size, part.CFrame
    local corners = {
        cf:PointToWorldSpace(Vector3.new(-size.X/2, -size.Y/2, -size.Z/2)),
        cf:PointToWorldSpace(Vector3.new( size.X/2, -size.Y/2, -size.Z/2)),
        cf:PointToWorldSpace(Vector3.new(-size.X/2,  size.Y/2, -size.Z/2)),
        cf:PointToWorldSpace(Vector3.new( size.X/2,  size.Y/2, -size.Z/2)),
        cf:PointToWorldSpace(Vector3.new(-size.X/2, -size.Y/2,  size.Z/2)),
        cf:PointToWorldSpace(Vector3.new( size.X/2, -size.Y/2,  size.Z/2)),
        cf:PointToWorldSpace(Vector3.new(-size.X/2,  size.Y/2,  size.Z/2)),
        cf:PointToWorldSpace(Vector3.new( size.X/2,  size.Y/2,  size.Z/2)),
    }
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    for _, c in ipairs(corners) do
        local sp, on = camera:WorldToViewportPoint(c)
        if on then
            if sp.X < minX then minX = sp.X end
            if sp.Y < minY then minY = sp.Y end
            if sp.X > maxX then maxX = sp.X end
            if sp.Y > maxY then maxY = sp.Y end
        end
    end
    if minX == math.huge then return nil end
    return minX, minY, maxX, maxY
end
local function IsMouseOverPlayer(player, mousePos, camera, ignoreList)
    local char = player.Character
    if not char then return false end
    local ray = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
    triggerRayParams.FilterDescendantsInstances = ignoreList
    local result = WS:Raycast(ray.Origin, ray.Direction * 1000, triggerRayParams)
    return result and result.Instance and result.Instance:IsDescendantOf(char)
end
