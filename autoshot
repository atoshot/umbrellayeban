local KeybindList = {
    gui = nil, frame = nil, scroll = nil, visible = false,
    refreshConn = nil,
}
local function kbGetStateText(flag)
    local v = library.flags[flag]
    if type(v) == "boolean" then return v and "ON" or "OFF", v and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100) end
    if type(v) == "table" then return "[" .. #v .. "]", library.accent end
    if type(v) == "number" then return tostring(v), library.accent end
    if type(v) == "string" then return v, library.accent end
    return "?", library.col_sub
end
local KB_ALLOWED_PREFIXES = { "trigger_", "sa_", "autoshot_", "esp_", "fly_", "bg_snow_" }
local function kbIsAllowed(flag)
    for _, p in ipairs(KB_ALLOWED_PREFIXES) do
        if string.sub(flag, 1, #p) == p then return true end
    end
    return false
end
local function kbRebuild()
    if not KeybindList.scroll then return end
    pcall(function()
        for _, c in ipairs(KeybindList.scroll:GetChildren()) do
            if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
        end
        local count = 0
        for flag, kb in pairs(library.keybinds) do
            if kb and kb.Key and kbIsAllowed(flag) then
                count += 1
                local row = mk("Frame", {
                    BackgroundColor3 = library.col_elem, BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 22),
                }, KeybindList.scroll)
                mk("UICorner", { CornerRadius = UDim.new(0, 4) }, row)
                mk("TextLabel", {
                    BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 0),
                    Size = UDim2.new(1, -90, 1, 0), Font = Enum.Font.Gotham,
                    Text = kb.Text or flag, TextColor3 = library.col_text,
                    TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                }, row)
                mk("TextLabel", {
                    BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(80, 16),
                    Font = Enum.Font.GothamBold, Text = kb.Key.Name,
                    TextColor3 = library.accent, TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Right,
                }, row)
                mk("UIStroke", { Color = library.col_stroke, Thickness = 1 }, row)
            end
        end
        for flag, val in pairs(library.flags) do
            if kbIsAllowed(flag) and library.options[flag] and library.options[flag].type ~= "keybind" then
                local active = false
                if type(val) == "boolean" then active = val
                elseif type(val) == "table" then active = #val > 0 end
                if active then
                    count += 1
                    local stateTxt, stateCol = kbGetStateText(flag)
                    local row = mk("Frame", {
                        BackgroundColor3 = library.col_elem, BorderSizePixel = 0,
                        Size = UDim2.new(1, 0, 0, 22),
                    }, KeybindList.scroll)
                    mk("UICorner", { CornerRadius = UDim.new(0, 4) }, row)
                    mk("TextLabel", {
                        BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 0),
                        Size = UDim2.new(1, -70, 1, 0), Font = Enum.Font.Gotham,
                        Text = flag, TextColor3 = library.col_text,
                        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                    }, row)
                    mk("TextLabel", {
                        BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
                        Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(60, 16),
                        Font = Enum.Font.GothamBold, Text = stateTxt,
                        TextColor3 = stateCol, TextSize = 11,
                        TextXAlignment = Enum.TextXAlignment.Right,
                    }, row)
                    mk("UIStroke", { Color = library.col_stroke, Thickness = 1 }, row)
                end
            end
        end
        if count == 0 then
            mk("TextLabel", {
                BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40),
                Font = Enum.Font.GothamBold, TextSize = 12,
                TextColor3 = library.col_sub, Text = "Nothing active.",
                TextXAlignment = Enum.TextXAlignment.Center,
            }, KeybindList.scroll)
        end
    end)
end
local function kbCreate()
    if KeybindList.gui and KeybindList.gui.Parent then
        KeybindList.visible = not KeybindList.visible
        KeybindList.gui.Enabled = KeybindList.visible
        if KeybindList.visible then kbRebuild() end
        return
    end
    local gui = mk("ScreenGui", {
        Name = "KeybindListWindow", ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 9997,
    }, CoreGui)
    if syn and syn.protect_gui then syn.protect_gui(gui) elseif protectgui then protectgui(gui) end
    local frame = mk("Frame", {
        Name = "KeybindList", BackgroundColor3 = library.col_panel,
        BackgroundTransparency = 0.25, BorderSizePixel = 0,
        Position = UDim2.new(0.01, 0, 0.35, 0),
        Size = UDim2.new(0, 230, 0, 320),
    }, gui)
    mk("UICorner", { CornerRadius = UDim.new(0, 10) }, frame)
    mk("UIStroke", { Color = library.accent, Thickness = 1.2, Transparency = 0.4 }, frame)
    mk("Frame", {
        BackgroundColor3 = library.accent, BorderSizePixel = 0,
        Position = UDim2.fromOffset(10, 11), Size = UDim2.fromOffset(3, 12),
    }, frame)
    mk("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, -20, 0, 22),
        Position = UDim2.new(0, 20, 0, 6), Font = Enum.Font.GothamBold,
        Text = "Keybind List", TextColor3 = library.col_text,
        TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)
    local scroll = mk("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -44), Position = UDim2.new(0, 8, 0, 36),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3, ScrollBarImageColor3 = library.accent,
        ScrollBarImageTransparency = 0.4,
    }, frame)
    mk("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
    KeybindList.gui = gui
    KeybindList.frame = frame
    KeybindList.scroll = scroll
    KeybindList.visible = true
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    kbRebuild()
    if not KeybindList.refreshConn then
        KeybindList.refreshConn = task.spawn(function()
            while KeybindList.gui and KeybindList.gui.Parent do
                task.wait(0.3)
                if KeybindList.visible then pcall(kbRebuild) end
            end
        end)
    end
end
local function kbToggle()
    if not KeybindList.gui or not KeybindList.gui.Parent then
        kbCreate()
    else
        KeybindList.visible = not KeybindList.visible
        KeybindList.gui.Enabled = KeybindList.visible
        if KeybindList.visible then kbRebuild() end
    end
end
_G.KeybindList = { toggle = kbToggle, rebuild = kbRebuild }

