-- ============================================================
--  FINAL RENDER STEPPED: ESP + TRIGGER (menu block)
-- ============================================================
RS.RenderStepped:Connect(function()
    if isMenuOpen() then return end

    UpdateESP()
    if not Config.Trigger.Active then return end
    if IsHoldingKnife() then return end
    local now = os.clock()
    local delay = Config.Trigger.Delay

    if Config.Trigger.UseSilentTarget and Silent.Enabled then
        local silentReady
        if Silent.BindMode == "Always" then silentReady = Silent.Enabled
        else silentReady = Silent.Enabled and Silent.HoldActive end

        if silentReady then
            local t = Silent.LockedTarget
            local validTarget = false
            if t and t.Character then
                local ok, valid = pcall(function() return _G.saCanTarget(t) end)
                if ok and valid then
                    local part = _G.saGetPart(t.Character, Silent.TargetPart)
                    if part then
                        local cam = GetCamera()
                        if cam then
                            local dist = (cam.CFrame.Position - part.Position).Magnitude
                            if dist <= Config.Trigger.MaxDist then validTarget = true end
                        end
                    end
                end
            end
            if validTarget then
                if (now - Config.Trigger.LastShot) >= math.max(delay, Config.Trigger.SilentTargetDelay) then
                    Config.Trigger.LastShot = now
                    local cam = GetCamera()
                    local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
                    local cx, cy = math.floor(vp.X / 2), math.floor(vp.Y / 2)
                    task.spawn(function()
                        VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                        task.wait(0.01)
                        VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                    end)
                end
                return
            end
        end
    end

    if (os.clock() - Config.Trigger.LastShot) < Config.Trigger.Delay then return end
    local cam = GetCamera(); if not cam then return end
    local mpos = UIS:GetMouseLocation()
    local target, closest = nil, Config.Trigger.Radius
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            local role = GetRole(player)
            if role ~= "Whitelist" and (Config.Targeting.TargetAll or role == "Target") then
                if IsPlayerAlive(player) and not IsPlayerKO(player) then
                    local char = player.Character
                    if char then
                        local tp = GetTargetPart(char)
                        if tp then
                            local dist = (cam.CFrame.Position - tp.Position).Magnitude
                            if dist <= Config.Trigger.MaxDist then
                                local onTarget = false
                                if Config.Trigger.Mode == "Player" then
                                    if IsMouseOverPlayer(player, mpos, cam, TriggerBaseIgnore) then onTarget = true end
                                else
                                    local minX, minY, maxX, maxY = Get2DBoundingBox(tp, cam)
                                    if minX and mpos.X >= minX and mpos.X <= maxX and mpos.Y >= minY and mpos.Y <= maxY then
                                        if Config.Trigger.WallCheck then
                                            local dir = (tp.Position - cam.CFrame.Position).Unit
                                            triggerRayParams.FilterDescendantsInstances = TriggerBaseIgnore
                                            local r = WS:Raycast(cam.CFrame.Position, dir * dist, triggerRayParams)
                                            if r then
                                                local hp = Players:GetPlayerFromCharacter(r.Instance:FindFirstAncestorOfClass("Model"))
                                                if hp == player then onTarget = true end
                                            end
                                        else onTarget = true end
                                    end
                                end
                                if onTarget then
                                    if Config.Trigger.Mode == "Hitbox" then
                                        local sp = cam:WorldToViewportPoint(tp.Position)
                                        local sd = (Vector2.new(sp.X, sp.Y) - mpos).Magnitude
                                        if sd < closest then target = player; closest = sd end
                                    else
                                        target = player; break
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if target then
        Config.Trigger.LastShot = os.clock()
        local mx, my = mpos.X, mpos.Y
        task.spawn(function()
            VIM:SendMouseButtonEvent(mx, my, 0, true, game, 1)
            task.wait(0.01)
            VIM:SendMouseButtonEvent(mx, my, 0, false, game, 1)
        end)
    end
end)
