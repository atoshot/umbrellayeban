        function group:addList(args)
            if not args.flag or not args.values then return warn("missing args") end
            local multiselect = args.multiselect == true
            local searchable = args.searchable == true
            local bulk = args.bulk == true
            local showDisp = args.showDisplayName == true
            local renderRows, updateCounter, updateHeader, openBody, closeBody
            local rows = {}
