local ModDetectorModule = (function()
    local MD = {
        enabled = true, showESP = true, showWatcherStatus = true, notifyOnJoin = true, playSound = true,
        groups = { { id = 605595634, minRank = 20, label = "BH STAFF" }, { id = 925309458, minRank = 50, label = "MOD" } },
        symbols = { "CHECK", "CROWN", "STAR", "SHIELD" },
        cache = {}, notified = {}, espObjects = {}, watcherStatus = {},
    }
    local function hasSymbol(name)
        for _, s in ipairs(MD.symbols) do if string.find(name, s, 1, true) then return true end end
        return false
    end
    local function isMod(p)
        if not p or p == LP then return false, nil end
        if MD.cache[p.UserId] then return MD.cache[p.UserId].isMod, MD.cache[p.UserId].label end
        if hasSymbol(p.Name) or hasSymbol(p.DisplayName) then
            MD.cache[p.UserId] = { isMod = true, label = "Symbol" }
            return true, "Symbol"
        end
        local labels = {}
        for _, g in ipairs(MD.groups) do
            local ok, rank = pcall(function() return p:GetRankInGroup(g.id) end)
            if ok and rank >= g.minRank then table.insert(labels, g.label .. " (" .. rank .. ")") end
        end
        if #labels > 0 then
            local l = table.concat(labels, " / ")
            MD.cache[p.UserId] = { isMod = true, label = l }
            return true, l
        end
        MD.cache[p.UserId] = { isMod = false }
        return false, nil
    end
    local function clearESP(p)
        local o = MD.espObjects[p.UserId]
        if o then if o.hl then o.hl:Destroy() end; MD.espObjects[p.UserId] = nil end
    end
    local function createESP(p)
        clearESP(p)
        local hl = Instance.new("Highlight")
        hl.FillColor = Color3.fromRGB(255, 40, 40); hl.OutlineColor = Color3.fromRGB(255, 0, 0)
        hl.FillTransparency = 0.5; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = p.Character; hl.Parent = p.Character or CoreGui
        MD.espObjects[p.UserId] = { hl = hl }
    end
    local function refreshESP(p)
        local m = isMod(p)
        if not m then clearESP(p); MD.watcherStatus[p.UserId] = nil; return end
        if not MD.showESP then clearESP(p); return end
        if not MD.espObjects[p.UserId] then createESP(p) end
    end
    local function notify(txt) library:notify(txt) end
    local function playSound()
        if not MD.playSound then return end
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId = "rbxassetid://6753645454"; s.Volume = 3; s.Parent = WS
            s:Play(); game:GetService("Debris"):AddItem(s, 5)
        end)
    end
    local function scan()
        if not MD.enabled then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local m, lbl = isMod(p)
                if m then
                    if not MD.notified[p.UserId] then
                        MD.notified[p.UserId] = true
                        if MD.notifyOnJoin then notify("Mod: " .. p.Name .. " [" .. (lbl or "?") .. "]") end
                        playSound()
                    end
                    refreshESP(p)
                else clearESP(p) end
            end
        end
    end
    RS.Heartbeat:Connect(function()
        if not MD.enabled then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local c = MD.cache[p.UserId]
                if c and c.isMod then refreshESP(p) end
            end
        end
    end)
    Players.PlayerAdded:Connect(function(p)
        MD.cache[p.UserId] = nil
        task.wait(1.5)
        if MD.enabled then
            local m, lbl = isMod(p)
            if m and not MD.notified[p.UserId] then
                MD.notified[p.UserId] = true
                if MD.notifyOnJoin then notify("Mod: " .. p.Name .. " [" .. (lbl or "?") .. "]") end
                playSound()
            end
        end
    end)
    Players.PlayerRemoving:Connect(function(p)
        clearESP(p); MD.cache[p.UserId] = nil; MD.notified[p.UserId] = nil
    end)
    task.spawn(function()
        while true do task.wait(5); if MD.enabled then for u in pairs(MD.cache) do MD.cache[u] = nil end; scan() end end
    end)
    local API = {}
    function API.SetEnabled(v) MD.enabled = not not v; if v then scan() end end
    function API.SetShowESP(v) MD.showESP = not not v end
    function API.SetShowWatcherStatus(v) MD.showWatcherStatus = not not v end
    function API.SetNotifyOnJoin(v) MD.notifyOnJoin = not not v end
    function API.SetPlaySound(v) MD.playSound = not not v end
    function API.Rescan() for u in pairs(MD.cache) do MD.cache[u] = nil end; scan() end
    API._state = MD
    API.isMod = isMod
    task.delay(2, scan)
    return API
end)()
