local HITBOX_MAX_SIZE = 100
local HitboxModule = (function()
    local HB = { Enabled = false, SizeX = 2, SizeY = 5, SizeZ = 1, Transparency = 1,
        Color = BrickColor.new("Really black"), Material = Enum.Material.Neon,
        OnlyTarget = false, UseRenderStepOverride = false, RenderPriority = 201 }
    local DEF = Vector3.new(2, 2, 1)
    local Cache = setmetatable({}, { __mode = "k" })
    local Hooked = setmetatable({}, { __mode = "k" })
    local hbConn
    local function find(character)
        if not character then return nil end
        local h = character:FindFirstChild("Hitbox")
        if not h then return nil end
        local p
        if h:IsA("BasePart") then p = h
        else for _, d in ipairs(h:GetDescendants()) do if d:IsA("BasePart") then p = d; break end end end
        if not p then return nil end
        local m = p:FindFirstChildOfClass("SpecialMesh") or p:FindFirstChildOfClass("Mesh")
        return { Part = p, Mesh = m, Root = h }
    end
    local function getT(player)
        local c = Cache[player]
        if c and c.Part and c.Part.Parent then return c end
        local char = player.Character
        if not char then return nil end
        local t = find(char)
        if t then Cache[player] = t end
        return t
    end
    local function should(player)
        local r = GetRole(player)
        if r == "Whitelist" then return false end
        if HB.OnlyTarget then return r == "Target" end
        return true
    end
    local function startKillerFor(player, part)
        if not SignalKiller.AutoEnabled then return end
        if not player or player == LP then return end
        if SignalKiller.OnlyTarget and GetRole(player) ~= "Target" then return end
        pcall(function()
            if not ActiveKillers[player.UserId] then
                startSignalKiller(player, part, { recursive = SignalKiller.Recursive, full = true })
            end
        end)
    end
    local function apply(player)
        local t = getT(player)
        if not t or not t.Part then return end
        local p, m = t.Part, t.Mesh
        local sz = Vector3.new(HB.SizeX, HB.SizeY, HB.SizeZ)
        pcall(function()
            if p.Size ~= sz then p.Size = sz end
            p.Transparency = HB.Transparency
            p.BrickColor = HB.Color
            p.Material = HB.Material
            p.CanCollide = false
            p.Massless = true
        end)
        if m then pcall(function() m.Scale = Vector3.new(1, 1, 1) end) end
        startKillerFor(player, p)
    end
    local function reset(player)
        local t = getT(player)
        if not t or not t.Part then return end
        pcall(function()
            t.Part.Size = DEF; t.Part.Transparency = 1; t.Part.CanCollide = false; t.Part.Massless = false
        end)
        if t.Mesh then pcall(function() t.Mesh.Scale = Vector3.new(1, 1, 1) end) end
        if ActiveKillers[player.UserId] then skCleanupPlayer(player.UserId) end
    end
    local function reapplyAll()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and should(p) and getT(p) then apply(p) end
        end
    end
    local function startLoop()
        if hbConn then return end
        hbConn = RS.Heartbeat:Connect(function()
            if not HB.Enabled then return end
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then
                    local t = getT(p)
                    if t then if should(p) then apply(p) else reset(p) end end
                end
            end
        end)
    end
    local function stopLoop()
        if hbConn then hbConn:Disconnect(); hbConn = nil end
    end
    local function hook(player)
        if player == LP or Hooked[player] then return end
        Hooked[player] = true
        player.CharacterAdded:Connect(function()
            Cache[player] = nil; skCleanupPlayer(player.UserId)
            task.wait(0.2)
            if HB.Enabled and should(player) then apply(player) end
        end)
        player.CharacterRemoving:Connect(function()
            Cache[player] = nil; skCleanupPlayer(player.UserId)
        end)
    end
    SubscribePlayer(hook, function(p)
        Cache[p] = nil; Hooked[p] = nil; skCleanupPlayer(p.UserId)
    end)
    for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then pcall(hook, p) end end
    return {
        Config = HB, MaxSize = HITBOX_MAX_SIZE,
        SetEnabled = function(v)
            HB.Enabled = not not v
            if HB.Enabled then
                SignalKiller.AutoEnabled = true
                startLoop(); reapplyAll()
            else
                SignalKiller.AutoEnabled = false
                stopLoop()
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LP then reset(p); skCleanupPlayer(p.UserId) end
                end
            end
        end,
        SetSizeX = function(v) HB.SizeX = math.clamp(v, 1, HITBOX_MAX_SIZE); if HB.Enabled then reapplyAll() end end,
        SetSizeY = function(v) HB.SizeY = math.clamp(v, 1, HITBOX_MAX_SIZE); if HB.Enabled then reapplyAll() end end,
        SetSizeZ = function(v) HB.SizeZ = math.clamp(v, 1, HITBOX_MAX_SIZE); if HB.Enabled then reapplyAll() end end,
        SetTransparency = function(v) HB.Transparency = math.clamp(v, 0, 1); if HB.Enabled then reapplyAll() end end,
        SetOnlyTarget = function(v) HB.OnlyTarget = not not v; if HB.Enabled then reapplyAll() end end,
        SetRenderStepOverride = function(v) HB.UseRenderStepOverride = not not v end,
        Inspect = function(p) local t = getT(p); if not t then return nil end return { Part = t.Part, PartName = t.Part.Name } end,
        ResetAll = function()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then reset(p); skCleanupPlayer(p.UserId) end
            end
        end,
    }
end)()
_G.HitboxModule = HitboxModule

