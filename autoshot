local function AutoShot_CheckShot()
    if not AutoShot.Monitoring then return end
    for _, starterPlayer in ipairs(Players:GetPlayers()) do
        if starterPlayer ~= LP and IsAutoShotTarget(starterPlayer) then
            local char = starterPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool and AutoShot.WeaponsEnabled[tool.Name] then
                    local ammo = tool:FindFirstChild(AutoShot.AmmoName)
                    if ammo and ammo:IsA("IntValue") then
                        local curr, prev = ammo.Value, AutoShot.LastAmmoPerTool[tool]
                        if prev ~= nil and curr < prev then
                            if AutoShot.AutoShootBurstShots > 1 then
                                task.spawn(function()
                                    for i = 1, AutoShot.AutoShootBurstShots do
                                        SimulateClick()
                                        if i < AutoShot.AutoShootBurstShots then task.wait(AutoShot.AutoShootBurstDelay) end
                                    end
                                end)
                            else SimulateClick() end
                        end
                        AutoShot.LastAmmoPerTool[tool] = curr
                    end
                end
            end
        end
