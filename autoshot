local function doTeleportToPlayer(name)
    if not name then library:notify("No player selected"); return end
    local target = Players:FindFirstChild(name)
    if not target then library:notify("Player not found"); return end
    local char = LP.Character
    if not char then library:notify("You're dead"); return end
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    if not myHRP then library:notify("No HRP"); return end
    local tChar = target.Character
    if not tChar then library:notify("Target not spawned"); return end
    local tHRP = tChar:FindFirstChild("HumanoidRootPart")
    if not tHRP then library:notify("Target no HRP"); return end
    local offset = library.flags["tp_offset"] or 3
    local dir = myHRP.Position - tHRP.Position
    if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
    dir = dir.Unit
    char:PivotTo(CFrame.new(tHRP.Position + dir * offset + Vector3.new(0, 0.5, 0)))
    library:notify("Teleported to " .. name)
end
local function doTeleportToCursor()
    local char = LP.Character
    if not char then library:notify("You're dead"); return end
    local cam = GetCamera(); if not cam then return end
    local mpos = UIS:GetMouseLocation()
    local ray = cam:ViewportPointToRay(mpos.X, mpos.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char }
    local result = WS:Raycast(ray.Origin, ray.Direction * 1000, params)
    if result and result.Position then
        char:PivotTo(CFrame.new(result.Position + Vector3.new(0, 3, 0)))
        library:notify("Teleported to cursor")
    else library:notify("Nothing to teleport to") end
end
